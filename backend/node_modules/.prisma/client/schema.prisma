datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  AUTHORITY
  ADMIN
  SUPER_ADMIN
  MODERATOR
}

enum IssueStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CITIZEN_VERIFICATION
  CLOSED
  REOPENED
  REJECTED
  DUPLICATE
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MediaType {
  IMAGE
  VIDEO
  RESOLUTION_IMAGE
}

enum VerificationVote {
  FIXED
  STILL_EXISTS
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CITIZEN)
  department    String?
  designation   String?
  avatar        String?
  location      String?  @default("Dhaka, Bangladesh")
  impactScore   Int      @default(0)
  reportsCount  Int      @default(0)
  verifiedCount Int      @default(0)
  resolvedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issues        Issue[]
  confirmations UserConfirmIssue[]
  follows       UserFollowIssue[]
  votes         CitizenVerificationVote[]

  @@map("users")
}

model Issue {
  id                   String        @id @default(cuid())
  trackingNumber       String        @unique
  title                String
  titleBn              String
  description          String
  descriptionBn        String?
  categoryId           String
  categoryName         String
  categoryNameBn       String?
  categoryGroup        String
  severity             IssueSeverity @default(MEDIUM)
  status               IssueStatus   @default(SUBMITTED)
  slaDays              Int           @default(7)
  targetResolutionDate DateTime?

  assignedAuthority    String?
  assignedAuthorityBn  String?
  assignedDepartment   String?
  assignedDepartmentBn String?
  assignedOfficer      String?

  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?

  communityConfirmations Int @default(0)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  location          IssueLocation?
  media             IssueMedia[]
  timeline          StatusHistoryEntry[]
  verificationVotes CitizenVerificationVote[]
  confirmations     UserConfirmIssue[]
  followers         UserFollowIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([severity])
  @@index([createdAt])
  @@map("issues")
}

model IssueLocation {
  id         String  @id @default(cuid())
  issueId    String  @unique
  issue      Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  address    String
  addressBn  String?
  area       String
  areaBn     String?
  ward       String
  wardBn     String?
  city       String  @default("Dhaka")
  cityBn     String? @default("ঢাকা")
  district   String  @default("Dhaka")
  districtBn String? @default("ঢাকা")
  division   String  @default("Dhaka")
  divisionBn String? @default("ঢাকা")

  @@index([area])
  @@index([ward])
  @@map("issue_locations")
}

model IssueMedia {
  id         String    @id @default(cuid())
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)
  url        String
  caption    String?
  uploadedAt DateTime  @default(now())

  @@map("issue_media")
}

model StatusHistoryEntry {
  id            String       @id @default(cuid())
  issueId       String
  issue         Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  oldStatus     IssueStatus?
  newStatus     IssueStatus
  changedById   String
  changedByName String
  changedByRole Role
  department    String?
  note          String
  noteBn        String?
  evidenceUrl   String?
  createdAt     DateTime     @default(now())

  @@index([issueId])
  @@map("status_history")
}

model CitizenVerificationVote {
  id        String           @id @default(cuid())
  issueId   String
  issue     Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  userName  String
  vote      VerificationVote
  comment   String?
  createdAt DateTime         @default(now())

  @@unique([issueId, userId])
  @@map("citizen_verification_votes")
}

model UserConfirmIssue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
  @@map("user_confirm_issues")
}

model UserFollowIssue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
  @@map("user_follow_issues")
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String
  email     String
  role      String
  severity  String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("security_audit_logs")
}
